# ===== Database (Aiven MySQL) =====
# Get this from your Aiven console: Service -> Overview -> Connection Information
# Format: mysql://AVNS_USER:PASSWORD@HOST:PORT/DBNAME?ssl-mode=REQUIRED
DATABASE_URL="mysql://avnadmin:PASSWORD@your-service-name.aivencloud.com:PORT/defaultdb?ssl-mode=REQUIRED"

# ===== Auth =====
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# ===== Seed data for first Platform Admin (used by `npm run seed`) =====
SEED_PLATFORM_ADMIN_EMAIL="admin@yourplatform.com"
SEED_PLATFORM_ADMIN_PASSWORD="ChangeMe123!"
SEED_PLATFORM_ADMIN_NAME="Platform Admin"

# ===== App =====
NEXT_PUBLIC_APP_NAME="Barber Business Manager"
