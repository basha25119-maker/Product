generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============ PLATFORM ============

enum PlatformAdminRole {
  SUPER_ADMIN
  ADMIN
}

model PlatformAdmin {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String
  name         String
  role         PlatformAdminRole @default(ADMIN)
  status       AccountStatus     @default(ACTIVE)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@map("platform_admins")
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  INACTIVE
}

enum SubscriptionPlan {
  STARTER
  PROFESSIONAL
  BUSINESS
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
}

// ============ TENANT ============

model Tenant {
  id       String        @id @default(cuid())
  name     String
  logoUrl  String?
  status   AccountStatus @default(ACTIVE)
  currency String        @default("GBP")
  timezone String        @default("Europe/London")
  address  String?
  phone    String?
  email    String?

  onboardingStep        Int       @default(0)
  onboardingCompletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  branches          Branch[]
  workers           Worker[]
  sales             Sale[]
  paymentMethods    PaymentMethod[]
  wagePayments      WagePayment[]
  attendance        Attendance[]
  rentPayments      RentPayment[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  subscription      Subscription?
  auditLogs         AuditLog[]

  @@map("tenants")
}

model Subscription {
  id        String             @id @default(cuid())
  tenantId  String             @unique
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan   @default(STARTER)
  status    SubscriptionStatus @default(TRIAL)
  startDate DateTime           @default(now())
  endDate   DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@map("subscriptions")
}

// ============ USERS ============

enum UserRole {
  OWNER
  MANAGER
  ACCOUNTANT
  STAFF
}

model User {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String        @unique
  passwordHash String
  name         String
  role         UserRole      @default(OWNER)
  status       AccountStatus @default(ACTIVE)

  mustResetPassword Boolean   @default(false)
  resetToken        String?   @unique
  resetTokenExpiry  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("users")
}

// ============ BRANCHES ============

enum BranchStatus {
  ACTIVE
  INACTIVE
}

model Branch {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  address     String?
  phone       String?
  email       String?
  openingDate DateTime?
  status      BranchStatus @default(ACTIVE)
  notes       String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workers      Worker[]
  sales        Sale[]
  wagePayments WagePayment[]
  attendance   Attendance[]
  rentPayments RentPayment[]
  expenses     Expense[]

  @@index([tenantId])
  @@map("branches")
}

// ============ WORKERS ============

enum WorkerStatus {
  ACTIVE
  INACTIVE
  LEFT
}

enum WageType {
  HOURLY
  DAILY
  WEEKLY
  MONTHLY
  COMMISSION
}

model Worker {
  id                String       @id @default(cuid())
  tenantId          String
  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId          String?
  branch            Branch?      @relation(fields: [branchId], references: [id])
  firstName         String
  lastName          String
  displayName       String?
  phone             String?
  email             String?
  startDate         DateTime?
  endDate           DateTime?
  status            WorkerStatus @default(ACTIVE)
  wageType          WageType     @default(COMMISSION)
  defaultWageAmount Decimal?     @db.Decimal(10, 2)
  notes             String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales        Sale[]
  wagePayments WagePayment[]
  attendance   Attendance[]

  @@index([tenantId])
  @@index([branchId])
  @@map("workers")
}

// ============ PAYMENT METHODS ============

model PaymentMethod {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales        Sale[]
  wagePayments WagePayment[]
  expenses     Expense[]

  @@index([tenantId])
  @@map("payment_methods")
}

// ============ SALES ============

model Sale {
  id              String        @id @default(cuid())
  tenantId        String
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id])
  workerId        String
  worker          Worker        @relation(fields: [workerId], references: [id])
  date            DateTime
  amount          Decimal       @db.Decimal(10, 2)
  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  reference       String?
  notes           String?       @db.Text

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([branchId])
  @@index([workerId])
  @@index([date])
  @@map("sales")
}

// ============ WAGES ============

model WagePayment {
  id              String         @id @default(cuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch         @relation(fields: [branchId], references: [id])
  workerId        String
  worker          Worker         @relation(fields: [workerId], references: [id])
  date            DateTime
  amount          Decimal        @db.Decimal(10, 2)
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  payPeriodStart  DateTime?
  payPeriodEnd    DateTime?
  notes           String?        @db.Text

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([branchId])
  @@index([workerId])
  @@index([date])
  @@map("wage_payments")
}

// ============ ATTENDANCE (drives automatic wage calculation) ============

enum AttendanceStatus {
  FULL_DAY
  HALF_DAY
  ABSENT
}

model Attendance {
  id       String           @id @default(cuid())
  tenantId String
  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId String
  branch   Branch           @relation(fields: [branchId], references: [id])
  workerId String
  worker   Worker           @relation(fields: [workerId], references: [id])
  date     DateTime         @db.Date
  status   AttendanceStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workerId, date])
  @@index([tenantId])
  @@index([branchId])
  @@index([date])
  @@map("attendance")
}

// ============ RENT ============

model RentPayment {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id])
  date        DateTime
  amount      Decimal   @db.Decimal(10, 2)
  periodStart DateTime?
  periodEnd   DateTime?
  notes       String?   @db.Text

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([branchId])
  @@index([date])
  @@map("rent_payments")
}

// ============ EXPENSES ============

model ExpenseCategory {
  id              String  @id @default(cuid())
  tenantId        String?
  tenant          Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  isGlobalDefault Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@index([tenantId])
  @@map("expense_categories")
}

model Expense {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch          @relation(fields: [branchId], references: [id])
  date            DateTime
  categoryId      String
  category        ExpenseCategory @relation(fields: [categoryId], references: [id])
  amount          Decimal         @db.Decimal(10, 2)
  paymentMethodId String?
  paymentMethod   PaymentMethod?  @relation(fields: [paymentMethodId], references: [id])
  description     String?
  notes           String?         @db.Text

  deletedAt DateTime?
  deletedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([branchId])
  @@index([date])
  @@map("expenses")
}

// ============ AUDIT LOG ============

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId     String?
  userEmail  String?
  action     String
  entityType String
  entityId   String?
  metadata   String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
  @@map("audit_logs")
}
